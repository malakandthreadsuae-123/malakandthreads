# ─────────────────────────────────────────────────────────────
# MALAKAND THREADS — environment variables (PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Production MUST be https://malakandtradesuae.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# MySQL / MariaDB connection (Prisma). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://db_user:db_password@localhost:3306/malakand_threads"
# Separate database used ONLY by integration tests (will be reset by tests!)
TEST_DATABASE_URL="mysql://db_user:db_password@localhost:3306/malakand_threads_test"

# Long random string (min 32 chars) used to sign tokens/cookies.  Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial super admin (used only by `npm run db:seed` / `npm run admin:create`)
ADMIN_INITIAL_EMAIL="malakandthreadsuae@gmail.com"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-temporary-password"

# SMTP (e.g. Hostinger email, Google Workspace, Brevo, Amazon SES). Leave blank to log emails instead of sending.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="MALAKAND THREADS <malakantradesuae@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="malakantradesuae@gmail.com"

# Stripe (online card payments). Use test keys (sk_test_...) until your account is approved for live.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# File uploads (absolute or project-relative directory outside /public)
UPLOAD_DIR="storage/uploads"
UPLOAD_MAX_MB="8"

# ── Production behaviour ──
# Redirect HTTP→HTTPS in the app (only enable after confirming the host forwards X-Forwarded-Proto; Hostinger "Force HTTPS" is preferred)
FORCE_HTTPS_REDIRECT="false"
# Set to "true" on staging/preview deployments to keep them out of search engines
ROBOTS_DISALLOW_ALL="false"
